# Copy this file to .env and fill in your API keys.
# .env is gitignored so your keys stay out of the repo.

OPENAI_API_KEY=your-openai-key-here

# Logfire write token (from a Logfire project's API key settings, "Send
# telemetry" capability). Required - agent.py calls logfire.configure()
# unconditionally, so it raises LogfireConfigError at startup without
# this set (or without running `uv run logfire auth` locally instead).
LOGFIRE_TOKEN=your-logfire-write-token-here
